{
  "name": "ganz-schoen-clever-punkteblock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktiver Wertungsblock für das Würfelspiel Ganz schön clever",
  "scripts": {
    "dev": "vite",
