    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
